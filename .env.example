# Supabase Connect > Transaction pooler (port 6543) for runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase direct connection or Session pooler (5432) for migrations.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="portfolio"
OWNER_EMAIL=""
OWNER_PASSWORD=""
# Optional Resend contact notifications:
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL=""
CONTACT_FROM_EMAIL=""
