generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role String @default("OWNER")
 createdAt DateTime @default(now())
}
model SiteSettings {
 id String @id @default("main")
 published Json
 draft Json?
 version Int @default(1)
 updatedAt DateTime @updatedAt
}
model Page {
 id String @id @default(cuid())
 slug String @unique
 title String
 position Int @default(0)
 sections Section[]
}
model Section {
 id String @id @default(cuid())
 pageId String
 page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
 kind String
 content Json
 position Int @default(0)
}
model Project {
 id String @id @default(cuid())
 slug String @unique
 title String
 discipline String
 year String
 client String
 description String
 cover String
 coverAlt String
 coverX Float @default(50)
 coverY Float @default(50)
 coverScale Float @default(1)
 featured Boolean @default(false)
 placeholder Boolean @default(true)
 published Boolean @default(false)
 position Int @default(0)
 version Int @default(1)
 draft Json?
 updatedAt DateTime @updatedAt
 categories ProjectCategory[]
 blocks ProjectContentBlock[]
 media MediaAsset[]
}
model ProjectCategory {
 id String @id @default(cuid())
 name String
 discipline String
 position Int @default(0)
 projects Project[]
 @@unique([discipline, name])
}
model ProjectContentBlock {
 id String @id
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 kind String
 content Json
 position Int @default(0)
}
model MediaAsset {
 id String @id @default(cuid())
 storagePath String @unique
 url String
 type String
 alt String @default("")
 size Int
 projectId String?
 project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
 createdAt DateTime @default(now())
}
model SocialLink {
 id String @id @default(cuid())
 label String
 url String
 position Int @default(0)
}
model ContactMessage {
 id String @id @default(cuid())
 name String
 email String
 subject String
 message String
 read Boolean @default(false)
 notificationStatus String @default("disabled")
 createdAt DateTime @default(now())
}
model ContentRevision {
 id String @id @default(cuid())
 entityId String
 entityType String
 content Json
 createdBy String
 createdAt DateTime @default(now())
 @@index([entityType, entityId, createdAt])
}
model RateLimit {
 key String @id
 count Int @default(1)
 expiresAt DateTime
}
